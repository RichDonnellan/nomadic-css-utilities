#!/bin/sh
#
# Blocks a commit on a PHP syntax error or an unformatted file.
#
# CHECKS STAGED CONTENT, NOT THE WORKING TREE. `git add -p` can stage a
# subset of a file, so what is about to land is not necessarily what is on
# disk. Every check reads `git show :file`, which is the version being
# committed. Checking the working tree instead would pass a commit that
# breaks the moment it is checked out.
#
# Prettier is fed through --stdin-filepath rather than a temp path so it
# still resolves .prettierrc.mjs and .prettierignore from the real location
# in the repo. Exit 1 from it means "not formatted"; exit 2 means "no parser
# for this extension" (SVGs, .gitignore) and is deliberately ignored, or the
# hook would block on files Prettier was never going to touch.
#
# Enable per clone (core.hooksPath is local config, not versioned):
#   git config core.hooksPath .githooks
#
# Bypass once: git commit --no-verify

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

tmpdir=$(mktemp -d) || exit 1
trap 'rm -rf "$tmpdir"' EXIT

prettier="$repo_root/node_modules/.bin/prettier"

# Pin the ROOT config. Prettier resolves per file, and nomadic-child carries a
# template/.prettierrc.mjs written for the directory it gets copied TO — from
# inside the repo it cannot resolve, so per-file resolution errors on every
# templated file. The repo's own npm scripts pass --config for this reason.
prettier_config=""
for candidate in "$repo_root/.prettierrc.mjs" "$repo_root/prettier.config.js"; do
	if [ -f "$candidate" ]; then
		prettier_config="$candidate"
		break
	fi
done

git diff --cached --name-only --diff-filter=ACMR |
	while IFS= read -r file; do
		case "$file" in
		*.php)
			git show ":$file" >"$tmpdir/staged.php" 2>/dev/null || continue
			if ! php -l "$tmpdir/staged.php" >/dev/null 2>&1; then
				printf 'PHP syntax error  %s\n' "$file"
				php -l "$tmpdir/staged.php" 2>&1 |
					sed "s|$tmpdir/staged.php|$file|; s|^|    |"
				: >"$tmpdir/failed"
			fi
			;;
		esac

		[ -x "$prettier" ] || continue

		err=$(git show ":$file" 2>/dev/null |
			"$prettier" --check ${prettier_config:+--config "$prettier_config"} \
				--stdin-filepath "$file" 2>&1 >/dev/null)

		case $? in
		0) ;;
		1)
			printf 'Not formatted     %s\n' "$file"
			: >"$tmpdir/failed"
			;;
		*)
			# Exit 2 is usually "no parser for this extension" (SVGs,
			# dotfiles) and is fine. It is ALSO how an unresolvable config
			# reports itself, which would otherwise disable this check
			# across a whole repo without saying so — seen once already.
			case "$err" in
			*"No parser could be inferred"*) ;;
			*)
				printf 'Prettier failed   %s\n' "$file"
				printf '%s\n' "$err" | head -2 | sed 's/^/    /'
				: >"$tmpdir/failed"
				;;
			esac
			;;
		esac
	done

if [ -e "$tmpdir/failed" ]; then
	printf '\nCommit blocked. Fix formatting with: npm run format\n'
	printf 'Then re-stage. To skip these checks: git commit --no-verify\n'
	exit 1
fi

exit 0
